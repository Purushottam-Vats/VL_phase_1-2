# ============================================================
# Virtual Lab for Learning Science - environment variables
# Copy this file to  backend/.env  and edit the values.
#   Windows (cmd):         copy .env.example backend\.env
#   Windows (PowerShell):  Copy-Item .env.example backend\.env
# NEVER commit the real .env file.
# ============================================================

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB ----
# Local MongoDB Community Server. Use 127.0.0.1, not "localhost" (avoids an IPv6 problem on Windows).
MONGODB_URI=mongodb://127.0.0.1:27017/virtual-lab
# MongoDB Atlas (free cloud database) looks like:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/virtual-lab?retryWrites=true&w=majority

# ---- Authentication ----
# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-or-more-characters
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Teachers must enter this code when registering. Leave EMPTY to disable teacher self-registration.
TEACHER_INVITE_CODE=RNSIT-TEACHER-2026

# ---- CORS / security ----
# Browser origins allowed to call the API (comma separated). The Vite dev proxy makes this optional in development.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Login/register attempts allowed per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=30

# ---- AI assistant (used from Phase 5; not needed yet) ----
# Get a key from https://console.anthropic.com/ . Keep it ONLY here, never in frontend code.
ANTHROPIC_API_KEY=

# ---- Tests (optional) ----
# By default the tests start an in-memory MongoDB. To use an existing MongoDB server instead:
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017
